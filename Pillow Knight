/* ---------- 简单按键读取（无去抖） ---------- */
static uint8_t key_down(GPIO_TypeDef* port, uint16_t pin)
{
    return (HAL_GPIO_ReadPin(port, pin) == GPIO_PIN_RESET); // 低电平按下
}

/* ---------- 游戏资源 ---------- */
